# Copy to .env.local for local development. NEVER commit real secrets.
# Server-only values must not be prefixed NEXT_PUBLIC_.

NODE_ENV=development
APP_ENV=development
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bmq_dev

# Local dev uses the dev auth / local storage / fake payments providers.
AUTH_PROVIDER=dev
STORAGE_PROVIDER=local
PAYMENT_PROVIDER=fake
SESSION_SECRET=replace-with-64-random-characters-replace-with-64-random-chars
STORAGE_SIGNING_SECRET=replace-with-another-64-random-characters-replace-with-another
FAKE_PAYMENT_WEBHOOK_SECRET=whsec_local_dev_only_change_me
CRON_SECRET=replace-with-a-long-random-cron-secret-value-0000

# --- Supabase (production / staging). Service role key is SERVER ONLY. ---
# AUTH_PROVIDER=supabase
# STORAGE_PROVIDER=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgres://postgres.<project>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# --- Stripe Connect, TEST MODE keys only until launch ---
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Notifications ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Beat My Quote <hello@your-domain>
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# --- Optional ---
# MALWARE_SCANNER_URL=https://clamav-rest.internal/scan
# SENTRY_DSN=

# --- Business settings (placeholders pending owner decisions) ---
CREW_WINDOW_HOURS=24
PARTNER_WINDOW_HOURS=72
OFFER_ACCEPT_HOURS=72
DEPOSIT_BASIS_POINTS=1000
SUCCESS_FEE_BASIS_POINTS=0
MINIMUM_JOB_PRICE_PENCE=50000
CONTRACT_TERMS_VERSION=draft-2026-11
